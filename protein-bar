            const desc = document.getElementById('expenseDescInput').value;
            const amt = parseFloat(document.getElementById('expenseAmountInput').value);
            if (!desc || !amt) return;

            expensesHistory.unshift({
                id: Date.now(),
                date: new Date().toLocaleDateString() + ' ' + new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
                desc: desc,
                amount: amt
            });
            saveDataToStorage();

            expenseDesc = '';
            expenseAmount = '';
            showNotificationMsg('💸 Gasto de reposición registrado.');
            render();
        }

        function updateExpenseDesc(id, val) {
            expensesHistory = expensesHistory.map(exp => String(exp.id) === String(id) ? { ...exp, desc: val } : exp);
            saveDataToStorage();
        }

        function updateExpenseAmount(id, val) {
            const num = parseFloat(val) || 0;
            expensesHistory = expensesHistory.map(exp => String(exp.id) === String(id) ? { ...exp, amount: num } : exp);
            saveDataToStorage();
        }

        function deleteExpense(id) {
            expensesHistory = expensesHistory.filter(exp => String(exp.id) !== String(id));
            saveDataToStorage();
            showNotificationMsg('🗑️ Gasto eliminado.');
            render();
        }

        function addCuentaCorriente() {
            const client = document.getElementById('ccClientInput').value;
            const desc = document.getElementById('ccDescInput').value;
            const amt = parseFloat(document.getElementById('ccAmountInput').value);
            if (!client || !desc || !amt) return;

            cuentaCorrienteHistory.unshift({
                id: Date.now(),
                date: new Date().toLocaleDateString(),
                client: client,
                desc: desc,
                amount: amt,
                paid: false
            });
