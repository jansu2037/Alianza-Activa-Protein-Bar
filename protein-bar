                                                    <td class="p-4 font-bold text-white text-sm">${sale.recipe}</td>
                                                    <td class="p-4 text-right text-sm text-amber-400">${formatCurrency(sale.cost)}</td>
                                                    <td class="p-4 text-right text-sm font-bold text-emerald-400">+${formatCurrency(sale.price - sale.cost)}</td>
                                                    <td class="p-4 text-right text-sm font-bold text-cyan-300">${formatCurrency(sale.price)}</td>
                                                </tr>
                                            `).join('')}
                                        </tbody>
                                    </table>
                                    ${salesHistory.length === 0 ? `<div class="p-16 text-center text-slate-400 text-sm">No hay ventas registradas todavía. Los datos se guardan mes a mes automáticamente.</div>` : ''}
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            else if (activeTab === 'cuentaCorriente') {
                const totalCCPendiente = cuentaCorrienteHistory.filter(f => !f.paid).reduce((s, x) => s + x.amount, 0);
                html += `
                    <div class="space-y-6">
                        <div class="bg-slate-800 rounded-2xl shadow-lg border border-slate-700 p-6 flex flex-col md:flex-row justify-between items-center gap-4">
                            <div>
                                <h2 class="text-2xl font-bold text-white">📝 Cuenta Corriente del Mes</h2>
                                <p class="text-sm text-slate-400 mt-1">Lleva el control exacto de quién te debe qué consumiciones este mes. Queda guardado hasta que marques como pagado o borres.</p>
                            </div>
                            <div class="bg-slate-900 border border-slate-700 p-4 rounded-xl text-center">
                                <span class="block text-xs text-slate-400 font-bold uppercase">Total Pendiente de Cobro</span>
                                <span class="text-xl font-black text-amber-400">${formatCurrency(totalCCPendiente)}</span>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                            <div class="bg-slate-800 rounded-2xl shadow-lg border border-slate-700 p-6 h-fit space-y-4">
                                <h3 class="font-bold text-white text-lg">➕ Registrar en Cuenta Corriente</h3>
                                <div class="space-y-3">
                                    <div>
                                        <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Nombre del Cliente</label>
                                        <input type="text" id="ccClientInput" value="${ccClient}" oninput="ccClient=this.value" placeholder="Ej. Juan Pérez" class="w-full p-3 bg-slate-900 border border-slate-700 text-white rounded-xl text-sm outline-none focus:border-cyan-500"/>
                                    </div>
                                    <div>
                                        <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Detalle (Trago / Batido)</label>
                                        <input type="text" id="ccDescInput" value="${ccDesc}" oninput="ccDesc=this.value" placeholder="Ej. Batido Cookies Advanced" class="w-full p-3 bg-slate-900 border border-slate-700 text-white rounded-xl text-sm outline-none focus:border-cyan-500"/>
                                    </div>
                                    <div>
                                        <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Monto a Deber ($)</label>
                                        <input type="number" id="ccAmountInput" value="${ccAmount}" oninput="ccAmount=this.value" placeholder="0.00" class="w-full p-3 bg-slate-900 border border-slate-700 text-white rounded-xl text-sm outline-none focus:border-cyan-500"/>
                                    </div>
                                    <button onclick="addCuentaCorriente()" class="w-full text-slate-950 font-extrabold py-3 rounded-xl transition-colors text-sm shadow-md hover:opacity-90" style="background-color: ${primaryColor}">
                                        Guardar en Cuenta Corriente
                                    </button>
                                </div>
                            </div>
                            <div class="lg:col-span-2 bg-slate-800 rounded-2xl shadow-lg border border-slate-700 overflow-hidden">
                                <div class="p-5 border-b border-slate-700 bg-slate-900 flex justify-between items-center">
                                    <h3 class="font-bold text-white text-lg">Listado de Cuenta Corriente Activa</h3>
                                    ${cuentaCorrienteHistory.length > 0 ? `<button onclick="cuentaCorrienteHistory=[]; saveDataToStorage(); render();" class="text-xs text-red-400 hover:underline font-bold">Limpiar Todo</button>` : ''}
                                </div>
                                <div class="overflow-x-auto">
                                    <table class="w-full text-left border-collapse">
                                        <thead>
                                            <tr class="bg-slate-900/60 text-xs uppercase tracking-wider text-slate-400 border-b border-slate-700">
                                                <th class="p-4 font-bold">Fecha</th>
                                                <th class="p-4 font-bold">Cliente</th>
                                                <th class="p-4 font-bold">Detalle</th>
                                                <th class="p-4 font-bold text-right">Monto</th>
                                                <th class="p-4 font-bold text-center">Estado / Pagado</th>
                                                <th class="p-4 font-bold text-center">Eliminar</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-700/60">
                                            ${cuentaCorrienteHistory.map(cc => `
                                                <tr class="hover:bg-slate-700/30 transition-colors ${cc.paid ? 'opacity-50 line-through' : ''}">
                                                    <td class="p-4 text-xs text-slate-400">${cc.date}</td>
                                                    <td class="p-4 font-bold text-white text-sm">${cc.client}</td>
                                                    <td class="p-4 text-sm text-slate-300">${cc.desc}</td>
                                                    <td class="p-4 text-right text-sm font-bold text-cyan-300">${formatCurrency(cc.amount)}</td>
                                                    <td class="p-4 text-center">
                                                        <button onclick="toggleCuentaCorrientePaid('${cc.id}')" class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all ${cc.paid ? 'bg-emerald-950 text-emerald-400 border border-emerald-800' : 'bg-amber-950 text-amber-400 border border-amber-800'}">
                                                            ${cc.paid ? '✅ Pagado' : '⏳ Pendiente'}
                                                        </button>
                                                    </td>
                                                    <td class="p-4 text-center">
                                                        <button onclick="deleteCuentaCorriente('${cc.id}')" class="p-2 text-red-400 hover:text-red-300 transition-colors">🗑️</button>
                                                    </td>
                                                </tr>
                                            `).join('')}
                                        </tbody>
                                    </table>
                                    ${cuentaCorrienteHistory.length === 0 ? `<div class="p-16 text-center text-slate-400 text-sm">No hay registros en cuenta corriente este mes.</div>` : ''}
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }

            else if (activeTab === 'branding') {
                html += `
                    <div class="bg-slate-800 rounded-2xl shadow-lg border border-slate-700 p-6 md:p-8 space-y-6 max-w-2xl mx-auto">
                        <div>
                            <h2 class="text-2xl font-bold text-white">Personalización de Marca & Logo</h2>
                            <p class="text-sm text-slate-400 mt-1">Configura el nombre de tu Protein Bar, los colores principales y sube tu logotipo oficial (sin límite de tamaño) para las etiquetas impresas.</p>
                        </div>
                        <div class="space-y-4 bg-slate-900 p-6 rounded-2xl border border-slate-700">
                            <div>
                                <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Nombre de tu Protein Bar</label>
                                <input type="text" value="${brandName}" oninput="brandName=this.value" class="w-full p-3 bg-slate-800 border border-slate-700 text-white rounded-xl text-sm font-medium outline-none focus:border-cyan-500"/>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Subir Imagen de Logo (Sin límite de tamaño)</label>
                                <div class="flex items-center gap-4">
                                    <label class="flex-1 cursor-pointer bg-slate-800 border-2 border-dashed border-slate-700 hover:border-cyan-500 p-4 rounded-xl flex items-center justify-center gap-2 text-slate-300 font-medium text-sm transition-colors">
                                        📁 <span>Seleccionar archivo de imagen...</span>
                                        <input type="file" accept="image/*" onchange="handleLogoUpload(event)" class="hidden"/>
                                    </label>
                                    <img src="${brandLogo}" alt="Logo preview" class="w-14 h-14 rounded-full object-cover border-2 shadow-sm" style="border-color: ${primaryColor}"/>
                                </div>
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Color Principal (Cyan)</label>
                                    <div class="flex items-center gap-3">
                                        <input type="color" value="${primaryColor}" onchange="primaryColor=this.value; saveDataToStorage(); render();" class="w-12 h-12 rounded-xl border border-slate-700 cursor-pointer bg-transparent"/>
                                        <span class="text-sm font-bold text-cyan-300">${primaryColor}</span>
                                    </div>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-400 uppercase mb-1">Color Secundario (Púrpura)</label>
                                    <div class="flex items-center gap-3">
                                        <input type="color" value="${secondaryColor}" onchange="secondaryColor=this.value; saveDataToStorage(); render();" class="w-12 h-12 rounded-xl border border-slate-700 cursor-pointer bg-transparent"/>
                                        <span class="text-sm font-bold text-purple-300">${secondaryColor}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="pt-4 border-t border-slate-700 flex justify-between items-center">
                                <button onclick="localStorage.removeItem(STORAGE_KEY); location.reload();" class="text-red-400 hover:underline text-xs font-bold">
                                    ⚠️ Borrar Todos los Datos & Reiniciar
                                </button>
                                <button onclick="saveDataToStorage(); showNotificationMsg('🎨 ¡Personalización guardada de forma permanente!')" class="text-slate-950 font-extrabold px-6 py-3 rounded-xl transition-all shadow-md text-sm hover:opacity-90" style="background-color: ${primaryColor}">
                                    Guardar Cambios de Marca
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }

            app.innerHTML = html;
        }

        window.onload = function () {
            render();
        };
    </script>
</body>
</html>
