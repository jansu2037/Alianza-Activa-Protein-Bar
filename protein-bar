        function calculateMetrics() {
            let totalBuyCost = 0;
            let totalSellPriceCost = 0;
            let tKcal = 0;
            let tProt = 0;
            let tCarbs = 0;
            let tFat = 0;
            let tFiber = 0;
            const labelSet = [];

            ingredients.forEach(item => {
                const invRef = inventory.find(i => String(i.id) === String(item.id)) || item;
                const buyPricePerUnit = (invRef.price || 0) / (invRef.weight || invRef.containerSize || 1);
                totalBuyCost += buyPricePerUnit * (item.used || 0);

                const sellBase = invRef.sellPrice !== undefined ? invRef.sellPrice : ((invRef.price || 0) * 1.5);
                const sellPricePerUnit = sellBase / (invRef.weight || invRef.containerSize || 1);
                totalSellPriceCost += sellPricePerUnit * (item.used || 0);

                tKcal += (invRef.kcal || 0) * (item.used || 0);
                tProt += (invRef.protein || 0) * (item.used || 0);
                tCarbs += (invRef.carbs || 0) * (item.used || 0);
                tFat += (invRef.fat || 0) * (item.used || 0);
                tFiber += (invRef.fiber || 0) * (item.used || 0);

                if (invRef.labelDetails) {
                    labelSet.push(`${invRef.name} (x${item.used}): ${invRef.labelDetails}`);
                }
            });

            const packBuyCost = packaging.reduce((sum, item) => {
                const invRef = inventory.find(i => String(i.id) === String(item.id)) || item;
                const costPerUnit = (invRef.price || 35000) / (invRef.containerSize || 100);
                return sum + (costPerUnit * (item.used || 0));
            }, 0);

            const packSellBase = packaging.reduce((sum, item) => {
                const invRef = inventory.find(i => String(i.id) === String(item.id)) || item;
                const sellBase = invRef.sellPrice !== undefined ? invRef.sellPrice : 50000;
                const costPerUnit = sellBase / (invRef.containerSize || 100);
                return sum + (costPerUnit * (item.used || 0));
            }, 0);

            const tCost = totalBuyCost + packBuyCost;
            const baseSellPrice = totalSellPriceCost + packSellBase;
            const sPrice = baseSellPrice * markupMultiplier;
            const prof = sPrice - tCost;
            const margin = sPrice > 0 ? (prof / sPrice) * 100 : 0;

            return {
                totalIngredientCost: totalBuyCost,
                totalPackagingCost: packBuyCost,
                totalCost: tCost,
                suggestedPrice: sPrice,
                profit: prof,
                profitMargin: margin,
                calculatedMacros: { kcal: tKcal, protein: tProt, carbs: tCarbs, fat: tFat, fiber: tFiber },
                aggregatedLabels: labelSet
            };
        }

        function handleRegisterSale() {
            const metrics = calculateMetrics();
