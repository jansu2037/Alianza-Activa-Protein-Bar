            cuentaCorrienteHistory = cuentaCorrienteHistory.map(f => String(f.id) === String(id) ? { ...f, paid: !f.paid } : f);
            saveDataToStorage();
            render();
        }

        function deleteCuentaCorriente(id) {
            cuentaCorrienteHistory = cuentaCorrienteHistory.filter(f => String(f.id) !== String(id));
