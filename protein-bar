                name: nameInput,
                image: newRecipeImage || 'https://placehold.co/600x400/06b6d4/ffffff?text=Receta',
                ingredients: JSON.parse(JSON.stringify(newRecipeDraftIngredients)),
                packaging: [{ id: 'p1', name: 'Empaque', used: 1 }]
