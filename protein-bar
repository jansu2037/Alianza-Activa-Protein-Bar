        function generateWhatsAppOrderLink() {
            const lowStockItems = inventory.filter(item => item.stock <= item.containerSize);
            let message = `Hola! 🥤 Necesito hacer un pedido de reposición para mi Protein Bar (${brandName}):\n\n`;
            if (lowStockItems.length > 0) {
                lowStockItems.forEach(item => {
                    const missing = Math.ceil((item.containerSize * 2 - item.stock) / item.containerSize);
                    message += `▪️ *${item.name}*: Quedan ${(item.stock).toFixed(1)} porciones. Sugerido: ${missing} envases.\n`;
                });
            } else {
                message += "Stock general estable. Solicito lista de actualización.\n";
            }
            message += "\n¡Quedo atento al total y pago!";
            return `https://wa.me/?text=${encodeURIComponent(message)}`;
        }

