        function updateInventoryPrice(id, val) {
            const num = Math.max(0, parseFloat(val) || 0);
            inventory = inventory.map(i => String(i.id) === String(id) ? { ...i, price: num } : i);
            saveDataToStorage();
            showNotificationMsg('💲 Precio de compra actualizado.');
            render();
        }

        function updateInventorySellPrice(id, val) {
            const num = Math.max(0, parseFloat(val) || 0);
            inventory = inventory.map(i => String(i.id) === String(id) ? { ...i, sellPrice: num } : i);
            saveDataToStorage();
            showNotificationMsg('💲 Precio de venta actualizado.');
            render();
        }

        function updateInventoryMargin(id, val) {
            const margin = parseFloat(val) || 0;
            inventory = inventory.map(item => {
                if (String(item.id) === String(id)) {
                    const buy = item.price || 0;
                    const sell = margin >= 100 ? buy * 3 : buy / (1 - margin / 100);
                    return { ...item, sellPrice: Math.round(sell) };
                }
                return item;
            });
            saveDataToStorage();
            showNotificationMsg('📊 Margen y precio de venta actualizados.');
            render();
        }

        function updateInventoryStock(id, val) {
            const num = Math.max(0, parseFloat(val) || 0);
            inventory = inventory.map(i => String(i.id) === String(id) ? { ...i, stock: num } : i);
            saveDataToStorage();
        }

        function updateInventorySize(id, val) {
            const num = Math.max(1, parseFloat(val) || 1);
            inventory = inventory.map(i => String(i.id) === String(id) ? { ...i, containerSize: num } : i);
            saveDataToStorage();
