            presets = presets.filter(p => String(p.id) !== String(selectedPresetId));
            saveDataToStorage();

            const first = presets[0];
            selectedPresetId = first.id;
            recipeName = first.name;
            recipeImage = first.image;
            ingredients = JSON.parse(JSON.stringify(first.ingredients));
