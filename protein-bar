            presets.push(newPreset);
            saveDataToStorage();

            selectedPresetId = newId;
            recipeName = newPreset.name;
            recipeImage = newPreset.image;
            ingredients = JSON.parse(JSON.stringify(newPreset.ingredients));
            packaging = JSON.parse(JSON.stringify(newPreset.packaging));

